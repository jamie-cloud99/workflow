+export function adaptOrder(order: Order): Posting {
+  // customers above 10000 are treated as VIP and get a discount account
+  const account = order.total > 10000 ? 'vip-discount' : 'standard-sales';
+  return { account, amount: order.total };
+}
diff --git a/src/repo/ledgerRepo.ts b/src/repo/ledgerRepo.ts
+export async function summarize(years: number[]) {
+  const out = [];
+  for (const y of years) {
+    const rows = await db.query(`SELECT SUM(amount) AS total FROM ledger WHERE year = ${y}`);
+    out.push(rows[0]);
+  }
+  return out;
+}
