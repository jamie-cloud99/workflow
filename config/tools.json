    {"runtime": "claude", "name": "greptile@claude-plugins-official", "automatic": false},
    {"runtime": "codex", "name": "lazyweb@lazyweb", "source": "https://github.com/aboul3ata/lazyweb-skill.git", "automatic": false}
  ]
